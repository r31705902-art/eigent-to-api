# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-a-random-secret-at-least-24-characters
PORT=8080

# Railway: Generate Domain; RAILWAY_PUBLIC_DOMAIN is detected automatically.
# Otherwise set the exact public HTTPS origin, used to print the login helper command.
PUBLIC_URL=

# Optional login source. HTTPS GET returning session JSON; NEVER a public gist.
EIGENT_AUTH_URL=
EIGENT_AUTH_URL_BEARER=
# Alternatives: raw token or JSON object. Never commit real values.
EIGENT_TOKEN=
EIGENT_AUTH_JSON=
AUTH_FILE=/data/session/auth.json

EIGENT_API_BASE=https://dev.eigent.ai
UPSTREAM_TIMEOUT=300
MAX_REQUEST_BYTES=2097152
MAX_CONCURRENCY=8
KEY_CACHE_SECONDS=60

# v0.2: tool-executing agent by default; passthrough keeps the v0.1 behavior.
API_MODE=eigent-agent
AGENT_MAX_STEPS=6
AGENT_MAX_OUTPUT_TOKENS=1024
